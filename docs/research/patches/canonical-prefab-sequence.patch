+Ldb2Document prefabSequence(const std::vector<int>& ids, bool uniqueRender = false) {
+    auto document = Ldb2Document::read(emptyLevel());
+    auto& group = document.root().field("dynamicMeshes");
+    group.field("count").setSigned(static_cast<std::int32_t>(ids.size()));
+    int registered = 0;
+    for (std::size_t i = 0; i < ids.size(); ++i) {
+        auto item = ArchiveNode::sequence("record" + std::to_string(i));
+        item.children.push_back(ArchiveNode::signedValue("fsmId", 0));
+        for (const auto name : {"useLightmaps", "pointLightsAffect", "continuousUpdate", "bulletCollision",
+                "characterCollision", "blockExplosions", "noDecals", "elevator"})
+            item.children.push_back(ArchiveNode::boolValue(name, false));
+        item.children.push_back(ArchiveNode::signedValue("physicalMaterial", -1));
+        item.children.push_back(ArchiveNode::signedValue("prefabId", ids[i]));
+        item.children.push_back(ArchiveNode::boolValue("unknownPrefabRenderFlag", uniqueRender));
+        for (const auto name : {"boundingBoxMin", "boundingBoxMax", "meshMidpoint"})
+            item.children.push_back(vector3(name));
+        const bool owns = ids[i] < 0 || ids[i] == registered;
+        if (owns || uniqueRender) item.children.push_back(emptyRecords("renderMeshes"));
+        if (owns) item.children.push_back(emptyRecords("collisionShapes"));
+        if (ids[i] >= 0 && owns) ++registered;
+        item.children.push_back(emptyRecords("animations"));
+        group.children.push_back(std::move(item));
+    }
+    return document;
+}
+
+void prefabSequenceTests() {
+    for (const bool uniqueRender : {false, true}) {
+        auto valid = prefabSequence({-1, -2, 0, -9, 1, 0, 1, 2, 2}, uniqueRender);
+        const auto bytes = valid.write();
+        require(Ldb2Document::read(bytes).write() == bytes, "Sequential prefab roundtrip changed bytes");
+        // All mutations retain complete payloads: the old first-seen-ID reader
+        // accepted them. Negative IDs must not increment the registered count.
+        for (const auto& test : std::vector<std::pair<std::vector<int>, int>>{
+                {{0}, 1}, {{0}, 2147483647}, {{0, 1}, 2}, {{-1, 0}, 1}, {{0, -2, 1}, 2}}) {
+            auto invalid = prefabSequence(test.first, uniqueRender);
+            auto& group = invalid.root().field("dynamicMeshes");
+            group.children.back().field("prefabId").setSigned(test.second);
+            const auto malformed = ArchiveWriter::write(invalid.root());
+            bool rejected = false;
+            try { Ldb2Document::read(malformed); }
+            catch (const std::runtime_error& error) {
+                rejected = std::string(error.what()).find("Invalid LDB2 prefab ID") != std::string::npos;
+            }
+            require(rejected, "Skipped prefab ID was not rejected at registration");
+            rejects([&] { invalid.write(); }, "Writer accepted a skipped prefab ID");
+        }
+    }
 }
 
